{
  "name": "seafarer.documents.manager",
  "main": "index.js",
  "version": "3.1.1",
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "components",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "seafarer.documents.manager"
    }
  },
  "scripts": {
    "bump": "node scripts/bump-version.js",
    "check:structure": "node scripts/check-structure.js",
    "menu": "node build-menu.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:prod:aab": "APP_MODE=production npx expo run:android --variant release",
    "build:prod:apk": "APP_MODE=production npx expo run:android --variant release --type apk",
    "build:test": "APP_MODE=development npx expo run:android",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "lint": "expo lint",
    "obfuscate": "node obfuscate.js",
    "postinstall": "patch-package",
    "build:android": "npx expo export -p android  && npm run obfuscate",
    "dev": "expo start",
    "build:apk": "node scripts/build-apk.js",
    "build:aab": "node scripts/build-aab.js",
    "build:aab:production": "node scripts/build-aab-production.js",
    "build:apk:dev": "node scripts/build-apk-dev.js",
    "build:apk:production": "node scripts/build-apk-production.js",
    "bump:version": "node scripts/bump-version.js",
    "set:version": "node scripts/set-version.js",
    "release": "npm run bump:version && npm run build:aab",
    "clean:android": "cd android && gradlew clean && cd ..",
    "clean:outputs": "rimraf outputs && mkdir outputs",
    "submit:production": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.0.14",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.19",
    "expo": "^57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-quick-actions": "^6.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.16.0",
    "i18n-js": "^4.5.1",
    "jszip": "^3.10.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.9",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-pdf": "^7.0.4",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "@types/react-native-dotenv": "^0.2.2",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "glob": "^13.0.0",
    "inquirer": "^13.2.2",
    "javascript-obfuscator": "^5.0.1",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
