{
  "expo": {
    "name": "Seafarer Documents Manager",
    "slug": "seafarer.documents.manager",
    "version": "3.1.9",
    "orientation": "all",
    "icon": "./assets/images/icon.png",
    "scheme": "seafarer-docs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "seafarer.documents.manager",
      "appleTeamId": "VL4B4R8D84",
      "deploymentTarget": "16.4",
      "buildNumber": "301093",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to allow seafarers to take photos of their certificates and documents for digital storage.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone, but it is required by the underlying file picker libraries to ensure full compatibility."
      }
    },
    "android": {
      "package": "seafarer.documents.manager",
      "versionCode": 301093,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-octopus.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "kspVersion": "2.1.20-1.0.32",
            "newArchEnabled": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reactnativepdf.** { *; }\n-keep class com.ReactNativeBlobUtil.** { *; }\n-keep class com.google.mlkit.** { *; }\n-dontwarn com.google.mlkit.**\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.horcrux.svg.** { *; }"
          },
          "ios": {
            "usePrecompiledModules": false,
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/kuka.png",
          "color": "#002147",
          "sounds": []
        }
      ],
      "./plugins/remove-audio-boot-receivers",
      "./plugins/android-signing",
      "./plugins/android-artifact-name",
      "./plugins/ios-fix-codegen-cycle",
      "./plugins/android-large-screen-fix",
      "./plugins/android-device-compat"
    ]
  }
}
