# ===========================================
# EXAMPLE ENVIRONMENT FILE
# Seafarer Documents Manager
# ===========================================
# 📝 ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл как .env.development или .env.production
# 2. Заполните все значения своими реальными ключами
# 3. НЕ коммитьте .env* файлы в Git!
# ===========================================

# ===========================================
# APP MODE
# ===========================================
# Возможные значения: development | production
APP_MODE=development

# ===========================================
# REVENUECAT
# ===========================================
# Получите API ключи на https://app.revenuecat.com/
# 
# Development Key: используется для тестирования
# Production Key: используется для реальных покупок в Google Play
REVENUECAT_API_KEY=goog_iSPWvwbLtHmLMoNZLONpAnOiFDu

# ===========================================
# APP VERSION
# ===========================================
# Формат: X.Y.Z или X.Y.Z-dev
# Примеры: 2.3.4 (production) или 2.3.4-dev (development)
APP_VERSION=2.3.8-dev-example

# ===========================================
# FEATURE FLAGS
# ===========================================
# TestingScreen: показывать экран для тестирования
# true - показывать (development)
# false - скрыть (production)
ENABLE_TESTING_SCREEN=false

# Bypass покупок: позволяет активировать premium без RevenueCat
# true - разрешить (development)
# false - запретить (production)
ENABLE_PURCHASE_BYPASS=false

# Debug логи: подробное логирование в консоль
# true - включить (development)
# false - выключить (production)
ENABLE_DEBUG_LOGS=false

# ===========================================
# OPTIONAL: ADDITIONAL SERVICES
# ===========================================
# Раскомментируйте и заполните если используете:

# API Backend URL
# API_URL=https://api.seafarerdocuments.com

# Sentry DSN (для отслеживания ошибок)
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Firebase Project ID
# FIREBASE_PROJECT_ID=seafarer-documents-xxxxx

# ===========================================
# QUICK REFERENCE
# ===========================================
# Development setup:
#   APP_MODE=development
#   ENABLE_TESTING_SCREEN=true
#   ENABLE_PURCHASE_BYPASS=true
#   ENABLE_DEBUG_LOGS=true
#
# Production setup:
#   APP_MODE=production
#   ENABLE_TESTING_SCREEN=false
#   ENABLE_PURCHASE_BYPASS=false
#   ENABLE_DEBUG_LOGS=false
# ===========================================
